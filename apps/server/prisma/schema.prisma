generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum VillageType {
  village
  town
  city
}

enum RelationshipType {
  spouse
  parent_child
  sibling
}

enum UserRole {
  user
  super_admin
}

enum TreeVisibility {
  open
  private
}

enum ConnectionStatus {
  pending
  accepted
  declined
}

// Mirrors a Supabase Auth user (id matches auth.users.id). Created on first login.
model Profile {
  id             String         @id
  email          String         @unique
  displayName    String?
  role           UserRole       @default(user)
  treeVisibility TreeVisibility @default(private)
  createdAt      DateTime       @default(now())

  people Person[]

  sentRequests     ConnectionRequest[] @relation("RequestFrom")
  receivedRequests ConnectionRequest[] @relation("RequestTo")

  @@index([email])
}

model ConnectionRequest {
  id     String            @id @default(uuid())
  status ConnectionStatus  @default(pending)

  fromUserId String
  fromUser   Profile @relation("RequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     Profile @relation("RequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  message     String?
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Village {
  id     String      @id @default(uuid())
  name   String
  type   VillageType @default(village)
  color  String
  region String?

  peopleNative  Person[] @relation("NativeVillage")
  peopleCurrent Person[] @relation("CurrentVillage")

  @@index([name])
}

// Shared, crowd-sourced reference lists: any user can pick an existing caste/subcaste or add a
// new one, which then becomes available for everyone else to reuse (same pattern as Village).
model Caste {
  id   String @id @default(uuid())
  name String

  people Person[]

  @@index([name])
}

model Subcaste {
  id   String @id @default(uuid())
  name String

  people Person[]

  @@index([name])
}

model Person {
  id       String  @id @default(uuid())
  name     String
  nameLocal String?
  gender   Gender
  dob      String?
  isDeceased Boolean @default(false)
  photoUrl String?
  // Relative birth order among siblings (lower = older). Set when a sibling is added via the
  // elder/younger prompt; used purely for left-to-right canvas layout, not stored as an absolute
  // birth rank across the whole tree.
  birthOrder Int?

  ownerId String
  owner   Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  nativeVillageId  String?
  nativeVillage    Village? @relation("NativeVillage", fields: [nativeVillageId], references: [id])
  currentVillageId String?
  currentVillage   Village? @relation("CurrentVillage", fields: [currentVillageId], references: [id])
  casteId    String?
  caste      Caste?    @relation(fields: [casteId], references: [id])
  subcasteId String?
  subcaste   Subcaste? @relation(fields: [subcasteId], references: [id])

  // Array of { villageId, fromDate?, event } — see apps/server/src/types.ts LocationEvent
  locationHistory Json @default("[]")

  addedBy      String?
  lastEditedBy String?
  verified     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationshipsAsA Relationship[] @relation("PersonA")
  relationshipsAsB Relationship[] @relation("PersonB")

  @@index([name])
  @@index([currentVillageId])
  @@index([ownerId])
}

model Relationship {
  id     String            @id @default(uuid())
  type   RelationshipType
  personAId String
  personA   Person @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId String
  personB   Person @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)

  marriageDate     String?
  isConsanguineous Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([personAId])
  @@index([personBId])
}
